# ContestLogger – Konfiguration (KEY=VALUE, wie eine .env-Datei)
# Als „contestlogger.env“ neben das Programm legen (portable) oder nach /etc/contestlogger/contestlogger.env (Server).
# Kommandozeilen-Optionen überstimmen diese Datei; Umgebungsvariablen CONTESTLOGGER_<KEY> ebenfalls.

# Netzwerk: 0.0.0.0 = im ganzen LAN erreichbar, 127.0.0.1 = nur lokal (z. B. hinter nginx)
HOST=0.0.0.0
PORT=8000

# Datenbank (Sicherungen landen daneben in backup/, eigene Sprachen in lang/)
# portable Standard: data/contestlogger.db neben dem Programm – Server: /var/lib/contestlogger/contestlogger.db
#DB=/var/lib/contestlogger/contestlogger.db

# Automatische Sicherung alle N Minuten (0 = aus)
BACKUP_MIN=15

# Adresse, die im QR-Code und in Links erscheint (hinter nginx der Hostname/die IP des Servers)
#PUBLIC_URL=http://contest.local/

# Windows: Browser beim Start öffnen (1/0)
OPEN_BROWSER=1

# ON4KST-Server (normalerweise unverändert)
#KST_HOST=www.on4kst.info
#KST_PORT=23000

# Optionales GitHub-Token (nur nötig, wenn das Repo privat ist – Update-Prüfung und Stationsdatenbank-Abgleich)
#GITHUB_TOKEN=

# Betreuer-Modus: schaltet die Quellen-Importe für die zentrale Stationsdatenbank frei (Ergebnislisten,
# DARC-Contest-Hub, Stationslisten anderer Nutzer laden). Normale Installationen lassen das aus und holen
# die gepflegte Liste über „Nach neuen suchen (Repo)“.
#MAINTAINER=0
