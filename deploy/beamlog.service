# systemd-Unit für BeamLog
# Installation: sudo cp deploy/beamlog.service /etc/systemd/system/ && sudo systemctl enable --now beamlog
[Unit]
Description=BeamLog – Amateurfunk-Contest-Logger
After=network.target

[Service]
Type=simple
User=beamlog
Group=beamlog
WorkingDirectory=/opt/beamlog
Environment=PYTHONUNBUFFERED=1
# Alle Einstellungen (Host, Port, Datenbank, Backup-Takt, öffentliche Adresse …) stehen in
# /opt/beamlog/.env – nach Änderungen:  sudo systemctl restart beamlog
ExecStart=/opt/beamlog/.venv/bin/python run.py --config /opt/beamlog/.env
Restart=always
RestartSec=3

# Port aus .env – auch Port 80 ohne nginx (PORT=80): der Dienst darf Ports < 1024 öffnen, sonst keine Rechte
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/beamlog

[Install]
WantedBy=multi-user.target
