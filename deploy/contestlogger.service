# systemd-Unit für den ContestLogger
# Installation: sudo cp deploy/contestlogger.service /etc/systemd/system/ && sudo systemctl enable --now contestlogger
[Unit]
Description=ContestLogger – Amateurfunk-Contest-Logger
After=network.target

[Service]
Type=simple
User=contestlogger
Group=contestlogger
WorkingDirectory=/opt/contestlogger
Environment=PYTHONUNBUFFERED=1
# Der Server lauscht nur lokal; nginx reicht die Anfragen auf Port 80 durch.
ExecStart=/opt/contestlogger/.venv/bin/python run.py --host 127.0.0.1 --port 8000 --db /var/lib/contestlogger/contestlogger.db
Restart=always
RestartSec=3

# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/contestlogger

[Install]
WantedBy=multi-user.target
