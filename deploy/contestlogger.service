# systemd-Unit für den ContestLogger
# Installation: sudo cp deploy/contestlogger.service /etc/systemd/system/ && sudo systemctl enable --now contestlogger
[Unit]
Description=ContestLogger – Amateurfunk-Contest-Logger
After=network.target

[Service]
Type=simple
User=contestlogger
Group=contestlogger
WorkingDirectory=/opt/contestlogger
Environment=PYTHONUNBUFFERED=1
# Alle Einstellungen (Host, Port, Datenbank, Backup-Takt, öffentliche Adresse …) stehen in
# /etc/contestlogger/contestlogger.env – nach Änderungen:  sudo systemctl restart contestlogger
ExecStart=/opt/contestlogger/.venv/bin/python run.py --config /etc/contestlogger/contestlogger.env
Restart=always
RestartSec=3

# Härtung
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/contestlogger

[Install]
WantedBy=multi-user.target
