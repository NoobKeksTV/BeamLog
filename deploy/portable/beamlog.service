# systemd-Unit für die portable Linux-Version von BeamLog (Binary aus dem Release-ZIP)
# Installation über deploy/install.sh – oder von Hand:
#   sudo cp deploy/beamlog.service /etc/systemd/system/ && sudo systemctl enable --now beamlog
[Unit]
Description=BeamLog – Amateurfunk-Contest-Logger (portable)
After=network.target

[Service]
Type=simple
User=beamlog
Group=beamlog
WorkingDirectory=/opt/beamlog
# Alle Einstellungen (Host, Port, Datenbank, Backup-Takt, öffentliche Adresse …) stehen in
# /etc/beamlog/beamlog.env – nach Änderungen:  sudo systemctl restart beamlog
ExecStart=/opt/beamlog/BeamLog --config /etc/beamlog/beamlog.env
Restart=always
RestartSec=3

# Port aus beamlog.env – auch Port 80 ohne nginx (PORT=80): der Dienst darf Ports < 1024 öffnen, sonst keine Rechte
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Härtung (das Binary entpackt sich beim Start nach /tmp – PrivateTmp hält das getrennt)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/beamlog

[Install]
WantedBy=multi-user.target
