# systemd-Unit für die portable Linux-Version von BeamLog (Binary aus dem Release-ZIP)
# Installation über deploy/install.sh – oder von Hand:
#   sudo cp deploy/beamlog.service /etc/systemd/system/ && sudo systemctl enable --now beamlog
[Unit]
Description=BeamLog – Amateurfunk-Contest-Logger (portable)
After=network.target

[Service]
Type=simple
User=beamlog
Group=beamlog
WorkingDirectory=/opt/beamlog
# Alle Einstellungen (Host, Port, Datenbank, Backup-Takt, öffentliche Adresse …) stehen in der .env neben dem Programm
# (hier /opt/beamlog/.env) – BeamLog findet sie selbst, kein --config nötig. Nach Änderungen:  sudo systemctl restart beamlog
# Liegt BeamLog nicht in /opt/beamlog, in WorkingDirectory, ExecStart und ReadWritePaths den eigenen Ordner eintragen
# (bei einem Ordner unter /home zusätzlich ProtectHome=false und User/Group = Besitzer des Ordners) –
# oder einfach im Ordner „sudo ./beamlogctl install --here“, das schreibt die Unit passend.
ExecStart=/opt/beamlog/BeamLog
Restart=always
RestartSec=3

# Port aus .env – auch Port 80 ohne nginx (PORT=80): der Dienst darf Ports < 1024 öffnen, sonst keine Rechte
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Härtung (das Binary entpackt sich beim Start nach /tmp – PrivateTmp hält das getrennt)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/beamlog

[Install]
WantedBy=multi-user.target
