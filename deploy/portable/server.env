# BeamLog – Server-Konfiguration (KEY=VALUE)
# Vorlage für /opt/beamlog/.env (install.sh legt die Datei beim ersten Lauf daraus an).
# Nach Änderungen:  sudo systemctl restart beamlog
# Umgebungsvariablen BEAMLOG_<KEY> und Kommandozeilen-Optionen überstimmen diese Datei.

# Hinter nginx lauscht der Dienst nur lokal (nginx leitet Port 80 an PORT weiter).
# Ohne nginx direkt auf Port 80: PORT=80 und HOST=0.0.0.0 – danach  sudo bash deploy/install.sh --update
# (das Skript schaltet nginx dann ab; der Dienst darf Port 80 öffnen).
HOST=127.0.0.1
PORT=8000

# Datenbank – Sicherungen landen daneben in backup/, eigene Sprachen in lang/
#DB=/opt/beamlog/data/beamlog.db   # Standard: data/beamlog.db im Programmordner

# Automatische Sicherung alle N Minuten (0 = aus)
BACKUP_MIN=15

# Adresse, die im QR-Code und in Links erscheint (Hostname oder IP des Servers)
PUBLIC_URL=http://contest.local/

# ON4KST-Server (normalerweise unverändert)
#KST_HOST=www.on4kst.info
#KST_PORT=23000

# Optionales GitHub-Token (nur für ein privates Repo – Update-Prüfung und Stationsdatenbank-Abgleich)
#GITHUB_TOKEN=

# Betreuer-Modus: schaltet die Quellen-Importe für die zentrale Stationsdatenbank frei (Ergebnislisten,
# DARC-Contest-Hub, Stationslisten anderer Nutzer laden). Normale Installationen lassen das aus und holen
# die gepflegte Liste über „Nach neuen suchen (Repo)“.
#MAINTAINER=0
# gleichbedeutend: DEV=true
#DEV=false

# Demo-Modus für eine öffentliche Vorführ-Instanz: Admin- und Stations-Passwort fest „demo“, Updates/Einstellungen/
# KST/Backups gesperrt, täglich um DEMO_RESET (Serverzeit) und bei jedem Start ALLES LÖSCHEN und einen Beispiel-Contest
# neu anlegen. Nur mit eigener, leerer Datenbank – niemals auf einer echten Contest-Installation einschalten!
#DEMO=0
#DEMO_RESET=03:00
