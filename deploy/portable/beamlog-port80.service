# systemd-Unit: BeamLog DIREKT auf Port 80, OHNE nginx (portable Version)
# Ein normaler Nutzer darf Port 80 nicht öffnen – AmbientCapabilities gibt dem Dienst genau diese eine Berechtigung.
#   sudo cp deploy/beamlog-port80.service /etc/systemd/system/beamlog.service
#   sudo systemctl daemon-reload && sudo systemctl restart beamlog
# Vorher nginx stoppen/deaktivieren, falls es Port 80 belegt:  sudo systemctl disable --now nginx
[Unit]
Description=BeamLog – Amateurfunk-Contest-Logger (portable, Port 80)
After=network.target

[Service]
Type=simple
User=beamlog
Group=beamlog
WorkingDirectory=/opt/beamlog
# Einstellungen aus /etc/beamlog/beamlog.env; Host und Port werden hier fest auf 0.0.0.0:80 gesetzt
ExecStart=/opt/beamlog/BeamLog --config /etc/beamlog/beamlog.env --host 0.0.0.0 --port 80
Restart=always
RestartSec=3

# Port < 1024 als Nicht-root öffnen dürfen
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/beamlog

[Install]
WantedBy=multi-user.target
