# BeamLog – Server-Konfiguration (KEY=VALUE)
# Liegt nach der Installation unter /etc/beamlog/beamlog.env.
# Nach Änderungen:  sudo systemctl restart beamlog
# Umgebungsvariablen BEAMLOG_<KEY> und Kommandozeilen-Optionen überstimmen diese Datei.

# Hinter nginx lauscht der Dienst nur lokal; ohne nginx (beamlog-port80.service) setzt die Unit 0.0.0.0:80.
HOST=127.0.0.1
PORT=8000

# Datenbank – Sicherungen landen daneben in backup/, eigene Sprachen in lang/
DB=/var/lib/beamlog/beamlog.db

# Automatische Sicherung alle N Minuten (0 = aus)
BACKUP_MIN=15

# Adresse, die im QR-Code und in Links erscheint (Hostname oder IP des Servers)
PUBLIC_URL=http://contest.local/

# ON4KST-Server (normalerweise unverändert)
#KST_HOST=www.on4kst.info
#KST_PORT=23000

# Optionales GitHub-Token (nur für ein privates Repo – Update-Prüfung und Stationsdatenbank-Abgleich)
#GITHUB_TOKEN=

# Betreuer-Modus: schaltet die Quellen-Importe für die zentrale Stationsdatenbank frei (Ergebnislisten,
# DARC-Contest-Hub, Stationslisten anderer Nutzer laden). Normale Installationen lassen das aus und holen
# die gepflegte Liste über „Nach neuen suchen (Repo)“.
#MAINTAINER=0
# gleichbedeutend: DEV=true
#DEV=false
