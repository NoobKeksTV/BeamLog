# systemd-Unit für die portable Linux-Version des ContestLoggers (Binary aus dem Release-ZIP)
# Installation über deploy/install.sh – oder von Hand:
#   sudo cp deploy/contestlogger.service /etc/systemd/system/ && sudo systemctl enable --now contestlogger
[Unit]
Description=ContestLogger – Amateurfunk-Contest-Logger (portable)
After=network.target

[Service]
Type=simple
User=contestlogger
Group=contestlogger
WorkingDirectory=/opt/contestlogger
# Alle Einstellungen (Host, Port, Datenbank, Backup-Takt, öffentliche Adresse …) stehen in
# /etc/contestlogger/contestlogger.env – nach Änderungen:  sudo systemctl restart contestlogger
ExecStart=/opt/contestlogger/ContestLogger --config /etc/contestlogger/contestlogger.env
Restart=always
RestartSec=3

# Härtung (das Binary entpackt sich beim Start nach /tmp – PrivateTmp hält das getrennt)
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/contestlogger

[Install]
WantedBy=multi-user.target
