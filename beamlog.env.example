# BeamLog – Konfiguration (KEY=VALUE, wie eine .env-Datei)
# Als „beamlog.env“ neben das Programm legen (portable) oder nach /etc/beamlog/beamlog.env (Server).
# Kommandozeilen-Optionen überstimmen diese Datei; Umgebungsvariablen BEAMLOG_<KEY> ebenfalls.

# Netzwerk: 0.0.0.0 = im ganzen LAN erreichbar, 127.0.0.1 = nur lokal (z. B. hinter nginx)
HOST=0.0.0.0
PORT=8000

# Datenbank (Sicherungen landen daneben in backup/, eigene Sprachen in lang/)
# portable Standard: data/beamlog.db neben dem Programm – Server: /var/lib/beamlog/beamlog.db
#DB=/var/lib/beamlog/beamlog.db

# Automatische Sicherung alle N Minuten (0 = aus)
BACKUP_MIN=15

# Adresse, die im QR-Code und in Links erscheint (hinter nginx der Hostname/die IP des Servers)
#PUBLIC_URL=http://contest.local/

# Windows: Browser beim Start öffnen (1/0)
OPEN_BROWSER=1

# ON4KST-Server (normalerweise unverändert)
#KST_HOST=www.on4kst.info
#KST_PORT=23000

# Optionales GitHub-Token (nur nötig, wenn das Repo privat ist – Update-Prüfung und Stationsdatenbank-Abgleich)
#GITHUB_TOKEN=

# Betreuer-Modus: schaltet die Quellen-Importe für die zentrale Stationsdatenbank frei (Ergebnislisten,
# DARC-Contest-Hub, Stationslisten anderer Nutzer laden). Normale Installationen lassen das aus und holen
# die gepflegte Liste über „Nach neuen suchen (Repo)“.
#MAINTAINER=0
# gleichbedeutend: DEV=true
#DEV=false

# Demo-Modus für eine öffentliche Vorführ-Instanz (z. B. beamlogdemo.lhprinting.de): Admin- und Stations-Passwort
# fest „demo“, Updates/Einstellungen/KST/Backups gesperrt, täglich um DEMO_RESET (Serverzeit) und bei jedem Start
# ALLES LÖSCHEN und einen Beispiel-Contest neu anlegen. Niemals auf einer echten Contest-Installation einschalten!
#DEMO=0
#DEMO_RESET=03:00
